# GPU (CUDA) image for running the emdb-simulator workspace headlessly with
# EGL-accelerated rendering, e.g. via Singularity's --nv on CESGA (see
# docs/source/howto/running_on_cesga.md). Published as
# santacrc/emdb_simulator_gpu by .github/workflows/docker.yml.
#
# Build from the REPO ROOT (not this docker/ directory), with submodules
# already checked out:
#   git submodule update --init --recursive
#   docker build -f docker/Dockerfile.gpu -t santacrc/emdb_simulator_gpu:latest .
#
# Like Dockerfile.cpu, RoboCasa's ~10GB kitchen assets are NOT baked in --
# see that file's header comment and docs/source/howto/running_on_cesga.md
# for the shared bind-mount approach.
#
# This does NOT bake in NVIDIA's proprietary driver/EGL libraries -- only
# the generic loader libs below. The real driver .so's and EGL vendor ICD
# are supplied at run time by Singularity's --nv (or Docker's --gpus all),
# which is the standard way to avoid pinning a driver version that drifts
# from whatever CESGA's compute nodes actually run.

FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

# Docker's default RUN shell is /bin/sh (dash), but ROS's setup.bash uses
# bash-only syntax (${BASH_SOURCE}, etc.) -- switch the default so any RUN
# that sources it (see the colcon build step below) doesn't hit "Bad
# substitution".
SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8

# ---------------------------------------------------------------------------
# 1. ROS 2 Humble. This base image doesn't have it preinstalled (unlike
#    ros:humble-ros-base used by Dockerfile.cpu), so bootstrap it from the
#    standard ROS 2 apt repository.
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        gnupg2 \
        lsb-release \
        locales \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
        > /etc/apt/sources.list.d/ros2.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-ros-base \
        ros-humble-ament-cmake \
        ros-humble-rmw-cyclonedds-cpp \
        python3-rosdep \
        python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*
# ros-humble-ament-cmake: emdb_interfaces (ament_cmake build type, see
# ros_packages/src/emdb_interfaces/CMakeLists.txt) needs this to build; it's
# not pulled in automatically by ros-humble-ros-base.
# ros-humble-rmw-cyclonedds-cpp: env.sh/entrypoint.sh default
# RMW_IMPLEMENTATION to rmw_cyclonedds_cpp, but only rmw_fastrtps_cpp is
# installed by default -- without this, every ros2/rclpy call fails at
# startup with "RMW implementation not installed".

# ---------------------------------------------------------------------------
# 2. Remaining system packages (mirrors Dockerfile.cpu's rationale), plus
#    generic GL loader libs for EGL rendering (no proprietary NVIDIA bits --
#    see file header comment).
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-venv \
        python3-pip \
        git \
        build-essential \
        xvfb \
        ffmpeg \
        libegl1 \
        libgl1 \
        libopengl0 \
        libglvnd0 \
        libgles2 \
    && rm -rf /var/lib/apt/lists/*

RUN [ -f /etc/ros/rosdep/sources.list.d/20-default.list ] || rosdep init; \
    rosdep update

WORKDIR /opt/emdb
COPY . .

# ---------------------------------------------------------------------------
# 3. Python virtualenv (same rationale as Dockerfile.cpu).
# ---------------------------------------------------------------------------
RUN python3 -m venv --system-site-packages /opt/emdb/.venv
ENV PATH="/opt/emdb/.venv/bin:${PATH}"
RUN pip install --upgrade pip wheel setuptools

# ---------------------------------------------------------------------------
# 4. CUDA-enabled torch, pinned explicitly (numeric-version parity with the
#    CPU image's 2.7.1+cpu pin, rather than leaving it to whatever pip's
#    resolver picks that day). Default index -> CUDA-enabled wheel, still
#    satisfies lerobot's torch<2.8.0,>=2.2.1 constraint.
# ---------------------------------------------------------------------------
RUN pip install torch==2.7.1 torchvision==0.22.1

# ---------------------------------------------------------------------------
# 5. robosuite / robocasa / (optional) robosuite_models, editable installs.
# ---------------------------------------------------------------------------
RUN pip install -e misc/robosuite -e misc/robocasa
RUN if [ -n "$(ls -A misc/robosuite_models 2>/dev/null)" ]; then \
        pip install -e misc/robosuite_models || \
            echo "robosuite_models install failed (optional) -- continuing"; \
    else \
        echo "misc/robosuite_models is empty, skipping (optional)"; \
    fi

RUN pip install colcon-common-extensions "empy==3.3.4"

RUN rosdep install --from-paths /opt/emdb/ros_packages/src --ignore-src -r -y

# ---------------------------------------------------------------------------
# 6. Asset mount point -- see Dockerfile.cpu step 5 for the full rationale.
#    No RUN needed: assets/ already exists after COPY.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 7. Build the ROS 2 workspace -- see Dockerfile.cpu step 6 for rationale
#    (including why /opt/ros/humble/setup.bash must be sourced explicitly
#    here rather than relying on ENTRYPOINT).
# ---------------------------------------------------------------------------
RUN . /opt/ros/humble/setup.bash && \
    cd ros_packages && python -m colcon build --symlink-install

COPY docker/entrypoint.sh /opt/emdb/entrypoint.sh
RUN chmod +x /opt/emdb/entrypoint.sh

ENV MUJOCO_GL=egl \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

ENTRYPOINT ["/opt/emdb/entrypoint.sh"]
CMD ["bash"]
